<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{EFEB6D1B-4068-4E88-92AB-0F50BD74E298}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="RRFMCLI\RRFMCLI.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="RRFMCLI">
        <MSBuild Projects="RRFMCLI\RRFMCLI.dproj"/>
    </Target>
    <Target Name="RRFMCLI:Clean">
        <MSBuild Projects="RRFMCLI\RRFMCLI.dproj" Targets="Clean"/>
